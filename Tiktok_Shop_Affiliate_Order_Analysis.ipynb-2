    {
      "cell_type": "markdown",
      "source": [
        "This shows the shop ads order versus organic orders. You see that by running the ads produced more in orders than affiliate orders."
      ],
      "metadata": {
        "id": "Q1-UZvy1LI4P"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "wenna = df[df[\"shop\"] == \"WENNALIFE\"]\n",
        "by_product = (wenna.groupby(\"product\")\n",
        "                   .agg(orders=(\"video_id\", \"count\"),\n",
        "                        commission=(\"commission\", \"sum\"),\n",
        "                        avg_price=(\"price\", \"mean\"))\n",
        "                   .sort_values(\"commission\", ascending=False))\n",
        "by_product.index = by_product.index.str[:50]   # shorten the long names\n",
        "by_product.head(200)\n"
      ],
      "metadata": {
